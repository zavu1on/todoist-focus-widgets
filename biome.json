{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "*.js", "*.ts", "*.tsx", "!dist", "!example"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "warn",
        "useExportType": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "expo-sqlite": {
                "message": "Use getDatabase() from @/features/database (composition roots only) or useDatabase() from @/shared/model instead of opening a second SQLite connection.",
                "importNames": [
                  "openDatabaseAsync",
                  "SQLiteProvider",
                  "useSQLiteContext"
                ]
              }
            }
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
